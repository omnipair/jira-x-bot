# Server Configuration
PORT=8080

# Jira Configuration
JIRA_PROJECT_KEY=
JIRA_WEBHOOK_SECRET=
# Ticket must have at least one of these labels to be posted (default: public)
REQUIRED_LABELS=public
# Tickets with any of these labels are never posted
EXCLUDED_LABELS=security,blocked,no-bot,no_bot

# X/Twitter OAuth 1.0a Credentials (4 tokens required)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Discord Configuration
DISCORD_WEBHOOK_URL=

# Feature Toggles (set to "false" to disable)
ENABLE_X=true
ENABLE_DISCORD=true

# Dry Run Options (set to "true" to test without posting)
DRY_RUN=false
DRY_RUN_TWITTER=false
DRY_RUN_DISCORD=false

# Branding Configuration (all optional)
BRAND_NAME=
BRAND_ICON_URL=
# Note: TWEET_HASHTAGS must be quoted because # is used for comments in .env files
TWEET_HASHTAGS=""